{%- comment -%}
  Relleno vertical de la sección controlado desde el editor. Va en el envoltorio #shopify-section-ID.
  Parámetro: section (obligatorio)
{%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} {
    --pt: {{ section.settings.padding_top | default: 80 }}px;
    --pb: {{ section.settings.padding_bottom | default: 80 }}px;
    padding-top: var(--pt);
    padding-bottom: var(--pb);
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: calc(var(--pt) * 0.6);
      padding-bottom: calc(var(--pb) * 0.6);
    }
  }
{%- endstyle -%}
