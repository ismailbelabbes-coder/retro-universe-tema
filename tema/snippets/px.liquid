{%- comment -%}
  Texto para etiquetas con Press Start 2P: esa fuente no tiene buenas mayúsculas con tilde,
  así que se quitan las tildes antes de que el CSS ponga el texto en mayúsculas.
  En alemán las diéresis se escriben ae, oe, ue y ß como ss.
  Uso: {% render 'px', text: block.settings.label %}
{%- endcomment -%}
{%- liquid
  assign t = text | strip_html
  if request.locale.iso_code == 'de'
    assign t = t | replace: 'ä', 'ae' | replace: 'ö', 'oe' | replace: 'ü', 'ue' | replace: 'Ä', 'Ae' | replace: 'Ö', 'Oe' | replace: 'Ü', 'Ue' | replace: 'ß', 'ss'
  endif
  assign t = t | replace: 'á', 'a' | replace: 'à', 'a' | replace: 'â', 'a' | replace: 'ä', 'a' | replace: 'ã', 'a' | replace: 'å', 'a'
  assign t = t | replace: 'é', 'e' | replace: 'è', 'e' | replace: 'ê', 'e' | replace: 'ë', 'e'
  assign t = t | replace: 'í', 'i' | replace: 'ì', 'i' | replace: 'î', 'i' | replace: 'ï', 'i'
  assign t = t | replace: 'ó', 'o' | replace: 'ò', 'o' | replace: 'ô', 'o' | replace: 'ö', 'o' | replace: 'õ', 'o'
  assign t = t | replace: 'ú', 'u' | replace: 'ù', 'u' | replace: 'û', 'u' | replace: 'ü', 'u' | replace: 'ç', 'c'
  assign t = t | replace: 'Á', 'A' | replace: 'À', 'A' | replace: 'Â', 'A' | replace: 'Ä', 'A' | replace: 'Ã', 'A'
  assign t = t | replace: 'É', 'E' | replace: 'È', 'E' | replace: 'Ê', 'E' | replace: 'Ë', 'E'
  assign t = t | replace: 'Í', 'I' | replace: 'Ì', 'I' | replace: 'Î', 'I' | replace: 'Ï', 'I'
  assign t = t | replace: 'Ó', 'O' | replace: 'Ò', 'O' | replace: 'Ô', 'O' | replace: 'Ö', 'O' | replace: 'Õ', 'O'
  assign t = t | replace: 'Ú', 'U' | replace: 'Ù', 'U' | replace: 'Û', 'U' | replace: 'Ü', 'U' | replace: 'Ç', 'C'
  assign t = t | replace: '¡', '' | replace: '¿', ''
-%}
{{- t | escape -}}
