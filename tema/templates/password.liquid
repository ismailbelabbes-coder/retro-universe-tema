{% form 'storefront_password' %}
  {{ form.errors | default_errors }}
  <label class="lbl" for="pw">Contraseña</label>
  <input class="field" id="pw" type="password" name="password" autocomplete="current-password" style="max-width:360px">
  <button class="btn" type="submit">{{ 'general.next' | t }}</button>
{% endform %}
