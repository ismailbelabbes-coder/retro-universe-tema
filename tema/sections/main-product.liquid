{% render 'section-style', section: section %}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign multi = false
  if product.variants.size > 1
    assign multi = true
  endif
  assign full_url = shop.url | append: product.url
  assign wa_msg = 'products.ask_message' | t: title: product.title, url: full_url
-%}
<div class="wrap" data-product>
  <nav class="crumbs" aria-label="Migas de pan" style="padding-top:20px"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>{% if collection %} / <a href="{{ collection.url }}">{{ collection.title | escape }}</a>{% endif %}</nav>
  <div class="prod">
    <div class="gallery">
      <div class="gallery__main gallery--{{ section.settings.gallery_fit }}{% if section.settings.gallery_zoom %} gallery--zoomable{% endif %}" role="group" aria-label="{{ 'products.gallery' | t }}">
        {%- for media in product.media -%}
          <div data-slide>
            {%- if media.media_type == 'image' -%}
              {%- if forloop.first -%}
                {% render 'img', image: media, alt: product.title, sizes: '(min-width: 900px) 50vw, 100vw', widths: '360, 540, 720, 960, 1200, 1500', priority: true %}
              {%- else -%}
                {% render 'img', image: media, alt: product.title, sizes: '(min-width: 900px) 50vw, 100vw', widths: '360, 540, 720, 960, 1200, 1500' %}
              {%- endif -%}
            {%- else -%}
              {{ media | media_tag: image_size: '1100x', controls: true, loading: 'lazy' }}
            {%- endif -%}
          </div>
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
        {%- endfor -%}
        {%- if section.settings.gallery_zoom and product.media.size > 0 -%}<span class="gallery__hint" aria-hidden="true">Zoom</span>{%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <ul class="thumbs" role="list">
          {%- for media in product.media -%}
            <li>
              <button class="thumb" type="button" data-thumb aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ 'products.image_n' | t: n: forloop.index, total: product.media.size }}">
                {{ media.preview_image | image_url: width: 160 | image_tag: width: 160, loading: 'lazy', alt: '' }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="prod__info">
      {%- if section.settings.show_vendor and product.vendor != blank -%}<p class="prod__vendor">{{ product.vendor | escape }}</p>{%- endif -%}
      <h1>{{ product.title | escape }}</h1>
      <div data-price>{% render 'price', product: product %}</div>

      {%- assign form_id = 'product-form-' | append: section.id -%}
      {%- form 'product', product, id: form_id, class: 'buy', data-product-form: '', data-ajax-cart: 'true' -%}
        <input type="hidden" name="id" value="{{ current.id }}">
        {%- if multi -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="opt">
              <legend>{% render 'px', text: option.name %}</legend>
              <div class="opt__row">
                {%- for value in option.values -%}
                  <input type="radio" id="opt-{{ section.id }}-{{ option.position }}-{{ forloop.index }}" name="options[{{ option.name | escape }}]" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                  <label for="opt-{{ section.id }}-{{ option.position }}-{{ forloop.index }}">{{ value | escape }}</label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endif -%}

        <div class="qty-row">
          <label class="lbl" for="qty-{{ section.id }}" style="margin:0">{{ 'products.quantity' | t }}</label>
          <div class="qty">
            <button type="button" data-qty-step="-1" aria-label="{{ 'products.decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
            <input id="qty-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
            <button type="button" data-qty-step="1" aria-label="{{ 'products.increase' | t }}">{% render 'icon', name: 'plus' %}</button>
          </div>
        </div>

        <button class="btn btn--full" type="submit" data-submit data-label="{{ 'products.add_to_cart' | t }}"{% unless current.available %} disabled{% endunless %}>
          {%- if current.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
        </button>
        {%- if section.settings.show_dynamic_checkout -%}
          {{ form | payment_button }}
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.show_whatsapp and settings.whatsapp_number != blank -%}
        <p class="buy" style="margin-top:8px"><a class="btn btn--wa" href="{% render 'whatsapp-url', message: wa_msg %}" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp' %}{{ 'products.ask_product' | t }}</a></p>
      {%- endif -%}
      {%- if section.settings.buy_note != blank -%}
        <p class="note" style="color:var(--ink-3);font-size:.9rem">{{ section.settings.buy_note | escape }}</p>
      {%- endif -%}

      {%- if product.description != blank -%}
        <div class="prod__desc rich" data-collapsible data-max="560" data-more="{{ 'products.read_more' | t }}" data-less="{{ 'products.read_less' | t }}">{{ product.description | replace: '<h1', '<h2' | replace: '</h1>', '</h2>' }}</div>
      {%- endif -%}
      {%- if section.settings.show_sku and current.sku != blank -%}
        <p class="meta" style="margin-top:16px">SKU: {{ current.sku | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_sticky_buy and product.available -%}
    <div class="sticky-buy" data-sticky-buy hidden>
      <div class="sticky-buy__info">
        <p class="sticky-buy__t">{{ product.title | escape }}</p>
        <p class="sticky-buy__p" data-sticky-price>{{ product.price | money }}</p>
      </div>
      <button class="btn" type="button" data-sticky-submit>{{ 'products.add' | t }}</button>
    </div>
  {%- endif -%}

  <script type="application/json" data-product-json>
    {
      "currency": {{ cart.currency.iso_code | json }},
      "variants": [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id }},
            "price": {{ v.price }},
            "compare_at_price": {{ v.compare_at_price | default: 0 }},
            "available": {{ v.available }},
            "options": {{ v.options | json }},
            "featured_media_index": {% if v.featured_media %}{{ v.featured_media.position | minus: 1 }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</div>
<script src="{{ 'product.js' | asset_url }}" defer></script>
<script type="application/ld+json">{{ product | structured_data }}</script>

{% schema %}
{
  "name": "Producto",
  "settings": [
    { "type": "select", "id": "gallery_fit", "label": "Encuadre de la foto principal", "default": "contain", "options": [
      { "value": "contain", "label": "Foto completa (no recorta)" },
      { "value": "cover", "label": "Recortada (llena el marco)" }
    ] },
    { "type": "checkbox", "id": "gallery_zoom", "label": "Ampliar la foto al pasar el ratón o al tocarla", "default": true },
    { "type": "checkbox", "id": "show_sticky_buy", "label": "Barra de compra fija en móvil (aparece al bajar)", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "Mostrar marca", "default": false },
    { "type": "checkbox", "id": "show_sku", "label": "Mostrar referencia (SKU)", "default": false },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Mostrar «Comprar ahora» (Apple Pay, Google Pay, etc.)", "info": "Usa el pago acelerado nativo de Shopify.", "default": true },
    { "type": "checkbox", "id": "show_whatsapp", "label": "Mostrar «Preguntar por WhatsApp» (opción secundaria)", "default": true },
    { "type": "text", "id": "buy_note", "label": "Nota bajo el botón de compra", "info": "Escribe solo condiciones ciertas (envío, garantía, devoluciones)." },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ]
}
{% endschema %}
