{% render 'section-style', section: section %}
<section class="powerups" aria-labelledby="pu-{{ section.id }}">
  <div class="wrap">
    <h2 class="h2 reveal" id="pu-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <div class="powerups__grid">
      {%- for block in section.blocks -%}
        <article class="pu{% if forloop.first %} pu--main{% endif %}" style="--c:var(--{{ block.settings.color }})" {{ block.shopify_attributes }}>
          <span class="pu__icon pix">{% render 'pix', name: block.settings.icon %}</span>
          {%- if block.settings.kicker != blank -%}<p class="pu__k" aria-hidden="true">{% render 'px', text: block.settings.kicker %}</p>{%- endif -%}
          <h3>{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}<p class="d">{{ block.settings.text | escape }}</p>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>
    {%- assign perks = section.settings.perks | newline_to_br | strip_newlines | split: '<br />' -%}
    {%- if section.settings.perks != blank -%}
      <ul class="perks">{%- for perk in perks -%}<li>{{ perk | strip | escape }}</li>{%- endfor -%}</ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Power-ups",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Power-ups incluidos" },
    { "type": "textarea", "id": "perks", "label": "Etiquetas inferiores (una por línea)", "default": "Contrarreembolso sin recargo\nFactura con IVA desglosado\n14 días para devolver", "info": "Escribe solo condiciones que sean ciertas y estén en vigor en la tienda." },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "powerup",
      "name": "Power-up",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icono de píxel", "default": "heart", "options": [
          { "value": "heart", "label": "Corazón" }, { "value": "star", "label": "Estrella" }, { "value": "bolt", "label": "Rayo" }, { "value": "coin", "label": "Moneda" }, { "value": "ghost", "label": "Fantasma" }
        ] },
        { "type": "text", "id": "kicker", "label": "Etiqueta pequeña", "default": "+3 vidas" },
        { "type": "text", "id": "title", "label": "Título", "default": "3 años de garantía y servicio técnico propio" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Si algo falla, lo arreglamos nosotros desde Mijas Costa: reparaciones, recambios y asesoramiento en español, sin intermediarios." },
        { "type": "select", "id": "color", "label": "Color", "default": "pink", "options": [
          { "value": "pink", "label": "Rosa" }, { "value": "cyan", "label": "Cian" }, { "value": "yellow", "label": "Amarillo" }, { "value": "violet", "label": "Violeta" }
        ] }
      ]
    }
  ],
  "presets": [
    {
      "name": "Power-ups",
      "blocks": [
        { "type": "powerup", "settings": { "icon": "heart", "kicker": "+3 vidas", "title": "3 años de garantía y servicio técnico propio", "text": "Si algo falla, lo arreglamos nosotros desde Mijas Costa: reparaciones, recambios y asesoramiento en español, sin intermediarios.", "color": "pink" } },
        { "type": "powerup", "settings": { "icon": "star", "kicker": "Nivel experto", "title": "Más de 20 años de experiencia", "text": "Montamos y configuramos cada máquina para que la enciendas y juegues.", "color": "yellow" } },
        { "type": "powerup", "settings": { "icon": "bolt", "kicker": "Speed up", "title": "Envío desde España", "text": "Con seguimiento y seguro a todo riesgo. Envío gratuito a partir de 30 € para España (solo Península) y Portugal.", "color": "cyan" } }
      ]
    }
  ]
}
{% endschema %}
