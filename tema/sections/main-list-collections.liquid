{% render 'section-style', section: section %}
<div class="wrap page">
  <h1>{{ 'collections.title' | t }}</h1>
  {%- if collections.size > 0 -%}
    <ul class="coll-list" role="list">
      {%- for collection in collections -%}
        {%- liquid
          assign image = collection.featured_image | default: collection.image
          if image == blank
            assign image = collection.products.first.featured_image
          endif
          assign cols = section.settings.colors | split: ','
          assign k = forloop.index0 | modulo: cols.size
        -%}
        <li><a class="player p-{{ cols[k] | strip }}" href="{{ collection.url }}">
          <span class="player__img">{%- if image != blank -%}{% render 'img', image: image, alt: '', sizes: '(min-width: 750px) 30vw, 45vw', widths: '240, 360, 540, 720' %}{%- endif -%}</span>
          <span class="player__name">{{ collection.title | escape }}</span>
          <span class="player__meta"><span>{{ 'products.models' | t: count: collection.products_count }}</span></span>
        </a></li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p class="lead">{{ 'collections.empty' | t }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Lista de colecciones",
  "settings": [
    { "type": "text", "id": "colors", "label": "Colores en orden (pink, cyan, yellow, violet)", "default": "pink,cyan,yellow,violet" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ]
}
{% endschema %}
