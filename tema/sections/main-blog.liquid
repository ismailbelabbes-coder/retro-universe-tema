{% render 'section-style', section: section %}
<div class="wrap page">
  <h1>{{ blog.title | escape }}</h1>
  {%- paginate blog.articles by section.settings.per_page -%}
    {%- if blog.articles.size > 0 -%}
      <ul class="articles" role="list">
        {%- for article in blog.articles -%}
          <li class="art">
            {%- if article.image -%}{% render 'img', image: article.image, alt: article.title, sizes: '(min-width: 750px) 30vw, 100vw', widths: '360, 540, 720, 960' %}{%- endif -%}
            <div class="art__body">
              <p class="meta"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | time_tag: '%d/%m/%Y' }}</time></p>
              <h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
              <p>{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <p class="lead">{{ 'blog.empty' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Entradas por página", "min": 3, "max": 24, "step": 3, "default": 9 },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ]
}
{% endschema %}
