{% render 'section-style', section: section %}
<div class="wrap page">
  <h1>{% if search.performed %}{{ 'search.results_for' | t: terms: search.terms }}{% else %}{{ 'search.title' | t }}{% endif %}</h1>
  <form class="search" action="{{ routes.search_url }}" method="get" role="search" style="max-width:640px">
    <label class="sr" for="q-main">{{ 'search.label' | t }}</label>
    <input class="field" id="q-main" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off"{% unless search.performed %} autofocus{% endunless %}>
    <input type="hidden" name="options[prefix]" value="last">
    <button class="btn" type="submit">{{ 'search.submit' | t }}</button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by section.settings.per_page -%}
      {%- if search.results.size == 0 -%}
        <p class="lead">{{ 'search.no_results' | t: terms: search.terms }}</p>
      {%- else -%}
        <p class="meta" role="status" style="margin-top:16px">{{ 'products.results' | t: count: search.results_count }}</p>
        <ul class="grid cols-3" role="list">
          {%- for item in search.results -%}
            <li>
              {%- if item.object_type == 'product' -%}
                {% render 'card-product', product: item %}
              {%- else -%}
                <article class="art"><div class="art__body"><h2><a href="{{ item.url }}">{{ item.title | escape }}</a></h2></div></article>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Búsqueda",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Resultados por página", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ]
}
{% endschema %}
