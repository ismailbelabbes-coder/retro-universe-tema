{% render 'section-style', section: section %}
{%- assign tags = 'P1,P2,P3,P4,P5,P6' | split: ',' -%}
<section class="players" id="jugador" aria-labelledby="players-{{ section.id }}">
  <div class="wrap">
    <h2 class="h2 reveal" id="players-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<div class="lead rich">{{ section.settings.text }}</div>{%- endif -%}
    <div class="players__grid cols-{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign target = block.settings.collection
          assign title = block.settings.title | default: target.title
          assign image = block.settings.image | default: target.featured_image | default: target.image
          if image == blank and target != blank
            assign image = target.products.first.featured_image
          endif
          assign min_price = nil
          if target != blank
            for p in target.products limit: 12
              if p.available
                if min_price == nil or p.price < min_price
                  assign min_price = p.price
                endif
              endif
            endfor
          endif
        -%}
        <a class="player p-{{ block.settings.color }}" href="{{ block.settings.link | default: target.url | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          <span class="player__tag" aria-hidden="true">{{ tags[forloop.index0] }}</span>
          <span class="player__img">
            {%- if image != blank -%}
              {% render 'img', image: image, alt: '', sizes: '(min-width: 990px) 22vw, 45vw', widths: '240, 360, 540, 720' %}
            {%- else -%}
              {% render 'demo-img', name: 'bartop-ghost', alt: '' %}
            {%- endif -%}
          </span>
          <span class="player__name">{{ title | escape }}</span>
          <span class="player__meta">
            {%- if target != blank -%}<span>{{ 'products.models' | t: count: target.products_count }}</span>{%- endif -%}
            {%- if min_price != nil -%}<b>{{ 'products.from' | t }} {{ min_price | money }}</b>{%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Selecciona tu jugador",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Selecciona tu jugador" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Cuatro formas de volver a los 80 y 90. Elige una y te llevamos directo a sus máquinas.</p>" },
    { "type": "select", "id": "columns", "label": "Columnas en escritorio", "default": "4", "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ] },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "player",
      "name": "Jugador",
      "limit": 6,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "title", "label": "Título (opcional)" },
        { "type": "image_picker", "id": "image", "label": "Imagen (opcional)" },
        { "type": "url", "id": "link", "label": "Enlace (opcional)" },
        { "type": "select", "id": "color", "label": "Color", "default": "pink", "options": [
          { "value": "pink", "label": "Rosa" }, { "value": "cyan", "label": "Cian" }, { "value": "yellow", "label": "Amarillo" }, { "value": "violet", "label": "Violeta" }
        ] }
      ]
    }
  ],
  "presets": [
    {
      "name": "Selecciona tu jugador",
      "blocks": [
        { "type": "player", "settings": { "color": "pink" } },
        { "type": "player", "settings": { "color": "cyan" } },
        { "type": "player", "settings": { "color": "yellow" } },
        { "type": "player", "settings": { "color": "violet" } }
      ]
    }
  ]
}
{% endschema %}
