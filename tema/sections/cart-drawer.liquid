{%- comment -%}
  Carrito lateral. Se refresca con la API de secciones de Shopify tras añadir o cambiar cantidades.
  Sin JavaScript, el icono de la cabecera lleva a /cart (el carrito nativo).
{%- endcomment -%}
<div class="backdrop" data-drawer-backdrop></div>
<aside class="drawer" id="cart-drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-t" aria-hidden="true" tabindex="-1">
  <div class="drawer__head">
    <div>
      <h2 id="drawer-t">{{ 'cart.title' | t }}</h2>
      <p class="px" aria-hidden="true">Credit <b data-count>{% if cart.item_count < 10 %}0{% endif %}{{ cart.item_count }}</b></p>
    </div>
    <button class="icon-btn" type="button" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
  </div>

  <div data-drawer-inner class="drawer__inner">
    {%- if cart.item_count == 0 -%}
      <div class="cart-empty">
        <span class="pix">{% render 'pix', name: 'ghost' %}</span>
        <p>{{ 'cart.empty' | t }}</p>
        <a class="btn btn--ghost" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
      </div>
    {%- else -%}
      {% render 'free-shipping' %}
      <ul class="drawer__list" role="list">
        {%- for item in cart.items -%}
          <li class="dline">
            <a class="line__img" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}{{ item.image | image_url: width: 160 | image_tag: width: 72, loading: 'lazy', alt: '' }}{%- endif -%}
            </a>
            <div>
              <a class="line__name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
              {%- unless item.product.has_only_default_variant -%}<p class="line__opts">{{ item.variant.title | escape }}</p>{%- endunless -%}
              <p class="line__total">{{ item.final_line_price | money }}</p>
              <div class="qty">
                <button type="button" data-line="{{ forloop.index }}" data-to="{{ item.quantity | minus: 1 }}" aria-label="{{ 'products.decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                <output aria-label="{{ 'products.quantity' | t }}" class="qty__n">{{ item.quantity }}</output>
                <button type="button" data-line="{{ forloop.index }}" data-to="{{ item.quantity | plus: 1 }}" aria-label="{{ 'products.increase' | t }}">{% render 'icon', name: 'plus' %}</button>
              </div>
            </div>
            <button class="line__del" type="button" data-line="{{ forloop.index }}" data-to="0" aria-label="{{ 'cart.remove' | t: title: item.product.title }}">{% render 'icon', name: 'trash' %}</button>
          </li>
        {%- endfor -%}
      </ul>
      <form class="drawer__foot" action="{{ routes.cart_url }}" method="post">
        <p class="tot"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></p>
        <p class="note">{% if cart.taxes_included %}{{ 'cart.taxes_note_included' | t }}{% else %}{{ 'cart.taxes_note' | t }}{% endif %}</p>
        <button class="btn btn--full" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
        <a class="btn btn--ghost btn--full" href="{{ routes.cart_url }}">{{ 'products.view_cart' | t }}</a>
      </form>
    {%- endif -%}
  </div>
</aside>

{% schema %}
{
  "name": "Carrito lateral",
  "settings": [
    { "type": "paragraph", "content": "Cajón de la cesta que se abre al añadir un producto o al pulsar el icono de la cesta. El pago siempre lo hace el checkout nativo de Shopify." }
  ]
}
{% endschema %}
