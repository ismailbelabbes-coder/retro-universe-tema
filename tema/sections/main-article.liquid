{% render 'section-style', section: section %}
<article class="wrap page">
  <p class="crumbs"><a href="{{ blog.url }}">{{ blog.title | escape }}</a></p>
  <h1>{{ article.title | escape }}</h1>
  <p class="meta">
    <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | time_tag: '%d/%m/%Y' }}</time>
    {%- if section.settings.show_author and article.author != blank %} · {{ 'blog.by' | t: author: article.author }}{% endif -%}
  </p>
  {%- if article.image -%}
    <div style="margin:24px 0;max-width:900px">{% render 'img', image: article.image, alt: article.title, sizes: '(min-width: 900px) 900px, 100vw', widths: '540, 720, 960, 1200', priority: true %}</div>
  {%- endif -%}
  <div class="prose rich">{{ article.content | replace: '<h1', '<h2' | replace: '</h1>', '</h2>' }}</div>
  <p style="margin-top:32px"><a class="btn btn--ghost" href="{{ blog.url }}">{{ 'blog.back' | t }}</a></p>
</article>
<script type="application/ld+json">{{ article | structured_data }}</script>

{% schema %}
{
  "name": "Artículo",
  "settings": [
    { "type": "checkbox", "id": "show_author", "label": "Mostrar autor", "default": false },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ]
}
{% endschema %}
