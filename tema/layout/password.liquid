<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    {{ content_for_header }}
  </head>
  <body>
    <main class="wrap sec" id="MainContent">
      <h1 class="h2">{{ 'password.title' | t }}</h1>
      <p class="lead">{{ 'password.text' | t }}</p>
      {{ content_for_layout }}
    </main>
  </body>
</html>
